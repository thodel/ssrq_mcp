# GPUStack embeds the incoming query for search_semantic. The passage vectors
# are already in ssrq.db, so without a key the corpus still answers keyword
# searches and get_document — only search_semantic fails.
# Reachable from inside the UniBE network only.
GPUSTACK_BASE_URL=https://gpustack.unibe.ch/v1
GPUSTACK_API_KEY=

# Must match the nginx location block exactly, or every request 404s.
SSRQ_HTTP_PATH=/mcp/ssrq/mcp
